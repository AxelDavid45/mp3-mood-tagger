    "flac-tagger": "^1.0.0",
    "node-id3": "^0.2.6",
    "ai": "^4.0.0",
    "@ai-sdk/anthropic": "^1.0.0",
    "dotenv": "^16.4.5",
    "glob": "^11.0.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "prettier": "3.8.1"
  }
