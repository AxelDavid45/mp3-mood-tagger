{
  "name": "music-tagger-cli",
  "version": "1.0.0",
  "description": "CLI tool for tagging music files with comments, genre and mood.",
  "main": "cli.js",
  "bin": {
    "music-tagger": "src/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "pnpm exec prettier . --write"
